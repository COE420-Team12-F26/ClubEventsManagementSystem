try"/></mxCell><mxCell id="pres" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;PresidentRole&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- roleCode: String = "PRESIDENT" {readOnly}&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ canManageRoles(): boolean&lt;br/&gt;+ canManageEvents(): boolean&lt;br/&gt;+ canViewBudget(): boolean&lt;br/&gt;+ canDecideBudgetRequests(): boolean&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="300" height="124" as="geometry"/></mxCell><mxCell id="vp" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;VicePresidentRole&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- roleCode: String = "VICE_PRESIDENT" {readOnly}&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ canManageEvents(): boolean&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="860" width="310" height="78" as="geometry"/></mxCell><mxCell id="exec" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;ExecutiveRole&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- roleCode: String = "EXECUTIVE" {readOnly}&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ canViewAssignedEvents(): boolean&lt;/p&gt;' style="verticalAlign=top;align=left;