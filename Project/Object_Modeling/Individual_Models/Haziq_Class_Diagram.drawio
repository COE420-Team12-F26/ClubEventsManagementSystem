<mxfile host="app.diagrams.net"><diagram id="haziq" name="Haziq Class Diagram"><mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Haziq Mohammad Khalid (@100601) | Event Creation, Cancellation and Approval | Individual UML Class Diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1200" height="30" as="geometry"/></mxCell><mxCell id="club" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&amp;laquo;stub&amp;raquo;&lt;br/&gt;&lt;b&gt;Club&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:10px;"&gt;(owner: Ahmed)&lt;/span&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ getFacultyAdvisor(): FacultyMember&lt;br/&gt;+ getEvents(): List&amp;lt;Event&amp;gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="290" height="126" as="geometry"/></mxCell><mxCell id="member" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&amp;laquo;stub&amp;raquo;&lt;br/&gt;&lt;b&gt;ClubMember&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:10px;"&gt;(owner: Ahmed)&lt;/span&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ isPresidentOrVicePresidentOf(club: Club): boolean&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="330" height="111" as="geometry"/></mxCell><mxCell id="evstatus" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;EventStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;PENDING&lt;br/&gt;CHANGES_REQUESTED&lt;br/&gt;APPROVED&lt;br/&gt;REJECTED&lt;br/&gt;CANCELLED&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1110" y="60" width="180" height="124" as="geometry"/></mxCell><mxCell id="revdec" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;ReviewDecision&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;APPROVED&lt;br/&gt;REJECTED&lt;br/&gt;CHANGES_REQUESTED&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1320" y="60" width="180" height="93" as="geometry"/></mxCell><mxCell id="event" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&lt;b&gt;Event&lt;/b&gt;&lt;/i&gt;&lt;br/&gt;&lt;span style="font-size:10px;"&gt;{abstract}&lt;/span&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- eventId: int&lt;br/&gt;- title: String&lt;br/&gt;- description: String&lt;br/&gt;- eventDate: Date&lt;br/&gt;- startTime: Time&lt;br/&gt;- endTime: Time&lt;br/&gt;- expectedAttendees: int&lt;br/&gt;- status: EventStatus&lt;br/&gt;- submittedAt: DateTime&lt;br/&gt;- cancellationReason: String&lt;br/&gt;- cancelledAt: DateTime&lt;br/&gt;- version: int&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ validate(): List&amp;lt;String&amp;gt;&lt;br/&gt;+ submit(): void&lt;br/&gt;+ updateDetails(title: String, description: String,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;eventDate: Date, startTime: Time, endTime: Time,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expectedAttendees: int): void&lt;br/&gt;+ resubmit(): void&lt;br/&gt;+ cancel(reason: String, cancelledBy: ClubMember,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expectedVersion: int): boolean&lt;br/&gt;+ canBeCancelled(now: DateTime): boolean&lt;br/&gt;+ overlaps(other: Event): boolean&lt;br/&gt;+ updateStatus(newStatus: EventStatus, expectedVersion: int): boolean&lt;br/&gt;+ getStatus(): EventStatus&lt;br/&gt;+ getReviewHistory(): List&amp;lt;EventReview&amp;gt;&lt;br/&gt;&lt;i&gt;+ getApprover(): FacultyMember&lt;/i&gt;&lt;br/&gt;&lt;u&gt;+ getPendingFor(faculty: FacultyMember): List&amp;lt;Event&amp;gt;&lt;/u&gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="450" height="459" as="geometry"/></mxCell><mxCell id="review" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;EventReview&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- reviewId: int&lt;br/&gt;- decision: ReviewDecision&lt;br/&gt;- comments: String&lt;br/&gt;- reviewedAt: DateTime&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ isValid(): boolean&lt;br/&gt;+ save(expectedVersion: int): boolean&lt;br/&gt;+ getDecision(): ReviewDecision&lt;br/&gt;+ getComments(): String&lt;br/&gt;+ getReviewer(): FacultyMember&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="330" height="178" as="geometry"/></mxCell><mxCell id="notif" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&amp;laquo;stub&amp;raquo;&lt;br/&gt;&lt;b&gt;Notification&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:10px;"&gt;(owner: Ahmed)&lt;/span&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ create(recipient: ClubMember, message: String): void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="240" width="400" height="111" as="geometry"/></mxCell><mxCell id="budget" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&amp;laquo;stub&amp;raquo;&lt;br/&gt;&lt;b&gt;BudgetRequest&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:10px;"&gt;(owner: Abdelrahman)&lt;/span&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ getEvent(): Event&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="365" width="400" height="111" as="geometry"/></mxCell><mxCell id="faculty" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&amp;laquo;stub&amp;raquo;&lt;br/&gt;&lt;b&gt;FacultyMember&lt;/b&gt;&lt;br/&gt;&lt;span style="font-size:10px;"&gt;(owner: Ahmed)&lt;/span&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ getName(): String&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="220" height="111" as="geometry"/></mxCell><mxCell id="off" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;OffCampusTrip&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- destination: String&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ getDestination(): String&lt;br/&gt;+ setDestination(destination: String): void&lt;br/&gt;+ getApprover(): FacultyMember&lt;br/&gt;+ assignAccompanyingFaculty(faculty: FacultyMember): void&lt;br/&gt;+ getAccompanyingFaculty(): FacultyMember&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="820" width="380" height="132" as="geometry"/></mxCell><mxCell id="on" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;OnCampusEvent&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ getRoom(): Room&lt;br/&gt;+ setRoom(room: Room): void&lt;br/&gt;+ runClashCheck(): ClashCheck&lt;br/&gt;+ getLatestClashCheck(): ClashCheck&lt;br/&gt;+ getApprover(): FacultyMember&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="820" width="300" height="132" as="geometry"/></mxCell><mxCell id="clash" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;ClashCheck&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- checkId: int&lt;br/&gt;- checkedAt: DateTime&lt;br/&gt;- overridden: boolean&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ run(): void&lt;br/&gt;+ hasClash(): boolean&lt;br/&gt;+ getConflictingEvents(): List&amp;lt;OnCampusEvent&amp;gt;&lt;br/&gt;+ getWarningMessage(): String&lt;br/&gt;+ overrideAndSubmit(): void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1400" y="820" width="320" height="163" as="geometry"/></mxCell><mxCell id="building" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Building&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- buildingCode: String&lt;br/&gt;- buildingName: String&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ getRooms(): List&amp;lt;Room&amp;gt;&lt;br/&gt;+ getRoomAllocator(): FacultyMember&lt;br/&gt;+ isRoomAllocator(faculty: FacultyMember): boolean&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="1110" width="350" height="116" as="geometry"/></mxCell><mxCell id="room" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Room&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;- roomCode: String&lt;br/&gt;- capacity: int&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"/&gt;&lt;p style="margin:0px;margin-left:6px;margin-right:6px;"&gt;+ getRoomCode(): String&lt;br/&gt;+ getBuilding(): Building&lt;br/&gt;+ getApprovedEvents(date: Date): List&amp;lt;OnCampusEvent&amp;gt;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="1110" width="360" height="116" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Status lifecycle (FR11, FR13–FR15)&lt;/b&gt;&lt;br/&gt;PENDING → APPROVED / REJECTED / CHANGES_REQUESTED (faculty review)&lt;br/&gt;CHANGES_REQUESTED → PENDING (resubmit)&lt;br/&gt;PENDING / APPROVED → CANCELLED (before start, reason required). Cancelled events are kept, not deleted.&lt;br/&gt;&lt;b&gt;Concurrency (NFR15):&lt;/b&gt; updateStatus() and cancel() compare expectedVersion with version; if another user changed the event first, the action is refused." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="490" width="420" height="128" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;validate() (NFR14)&lt;/b&gt; returns one error per field: date in the past, end time before start time, blank title or location, attendees ≤ 0.&lt;br/&gt;&lt;u&gt;getPendingFor()&lt;/u&gt; (static) lists the proposals a faculty member must review (UC12)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="640" width="420" height="66" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;getApprover()&lt;/b&gt; is abstract. OnCampusEvent returns its room's building's room allocator. OffCampusTrip returns its club's faculty advisor (FR11). The same check is enforced on the server before approve / reject / return (NFR12)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="978" width="380" height="84" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;EventReview.save()&lt;/b&gt; refuses a REJECTED or CHANGES_REQUESTED decision with no comments (FR13, FR14), then calls event.updateStatus(). An APPROVED trip review calls assignAccompanyingFaculty() (FR13). Old reviews are kept, so earlier comments stay visible." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="110" y="480" width="330" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;ClashCheck (FR12)&lt;/b&gt; runs when an on-campus event is submitted and finds APPROVED events in the same room at an overlapping time. If the booker submits anyway, overridden = true and the warning is shown to the building's room allocator." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1400" y="1060" width="320" height="96" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;Blue: classes I own (C01–C07)&lt;br/&gt;Grey dashed «stub»: classes owned by teammates; only the members my component uses are shown&lt;br/&gt;Purple: enumerations" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="360" height="80" as="geometry"/></mxCell><mxCell id="g1" value="" style="html=1;rounded=0;fontSize=11;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;fontStyle=2;labelBackgroundColor=none;align=center;verticalAlign=bottom;spacingBottom=2;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="off" target="event"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="780"/><mxPoint x="765" y="780"/></Array></mxGeometry></mxCell><mxCell id="g2" value="" style="html=1;rounded=0;fontSize=11;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;fontStyle=2;labelBackgroundColor=none;align=center;verticalAlign=bottom;spacingBottom=2;endArrow=block;endFill=0;endSize=14;startArrow=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="on" target="event"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="780"/><mxPoint x="765" y="780"/></Array></mxGeometry></mxCell><mxCell id="a1" value="organizes ▶" style="html=1;rounded=0;fontSize=11;fontFamily=Helvetica;edgeStyle=orthogonalEdgeStyle;fontStyle=2;labelBackgroundColor=none;align=center;verticalAlign=bottom;spacingBottom=2;endArrow=none;startArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="club" target="event"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="576" y="118"/></Array></mxGeomet